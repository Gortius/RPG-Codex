 </script>
+<!-- Load the emoji picker independently so a failure in another optional feature cannot prevent it from working. -->
+<script type="module">
+  import("./js/features/emoji-picker.js?v=20261025-emoji-picker-fix-r2")
+    .catch(error => {
+      console.error("RPG Codex emoji picker failed to initialize:", error);
+      const button = document.getElementById("open-emoji-picker");
+      if (button) {
+        button.disabled = true;
+        button.textContent = "Emoji library unavailable";
+        button.title = "The emoji picker could not load. Check the browser console and file path.";
+      }
+    });
+</script>
