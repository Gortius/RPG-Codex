+/* RPG Codex emoji picker */
+#custom-icon-section .emoji-picker-open-button {
+  margin-top: 8px;
+  min-height: 38px;
+}
+
+.emoji-picker-layer[hidden] { display: none !important; }
+.emoji-picker-layer {
+  position: fixed;
+  inset: 0;
+  z-index: 5000;
+  display: grid;
+  place-items: center;
+  padding: 18px;
+  background: rgba(5, 6, 10, .78);
+  backdrop-filter: blur(5px);
+}
+body.emoji-picker-open { overflow: hidden; }
+
+.emoji-picker-dialog {
+  display: flex;
+  flex-direction: column;
+  width: min(1100px, 100%);
+  max-height: min(88vh, 920px);
+  min-height: min(550px, 78vh);
+  overflow: hidden;
+  color: var(--text, #f1f1f4);
+  background: var(--panel, #191b20);
+  border: 1px solid var(--border, #2b2e35);
+  border-radius: 18px;
+  box-shadow: 0 28px 90px rgba(0, 0, 0, .45);
+}
+
+.emoji-picker-header {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+  gap: 20px;
+  padding: 22px 24px 16px;
+  border-bottom: 1px solid var(--border, #2b2e35);
+}
+.emoji-picker-header h2 { margin: 2px 0 6px; font-size: 23px; line-height: 1.15; }
+.emoji-picker-header p { margin: 0; color: var(--muted, #9296a2); line-height: 1.45; }
+.emoji-picker-header .emoji-picker-eyebrow {
+  color: var(--accent, #b9a0ff);
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: .14em;
+}
+.emoji-picker-close {
+  display: grid;
+  place-items: center;
+  flex: 0 0 auto;
+  width: 38px;
+  height: 38px;
+  border: 1px solid var(--border, #2b2e35);
+  border-radius: 10px;
+  background: transparent;
+  color: var(--text, #f1f1f4);
+  font-size: 28px;
+  line-height: 1;
+}
+.emoji-picker-close:hover { background: rgba(255,255,255,.06); }
+
+.emoji-picker-toolbar {
+  display: flex;
+  gap: 9px;
+  padding: 14px 24px 10px;
+}
+.emoji-picker-search-wrap {
+  display: flex;
+  align-items: center;
+  flex: 1 1 auto;
+  min-width: 0;
+  gap: 10px;
+  padding: 0 13px;
+  border: 1px solid var(--border, #2b2e35);
+  border-radius: 11px;
+  background: var(--bg, #101114);
+  color: var(--muted, #9296a2);
+  font-size: 21px;
+}
+.emoji-picker-search-wrap input {
+  width: 100%;
+  min-width: 0;
+  min-height: 43px;
+  padding: 6px 0;
+  border: 0;
+  outline: 0;
+  background: transparent;
+  color: var(--text, #f1f1f4);
+  font-size: 14px;
+  box-shadow: none;
+}
+.emoji-picker-search-wrap:focus-within { border-color: var(--accent, #b9a0ff); }
+.emoji-picker-clear { flex: 0 0 auto; }
+
+.emoji-picker-categories {
+  display: flex;
+  gap: 7px;
+  overflow-x: auto;
+  padding: 5px 24px 13px;
+  scrollbar-width: thin;
+}
+.emoji-category-chip {
+  flex: 0 0 auto;
+  padding: 7px 11px;
+  border: 1px solid var(--border, #2b2e35);
+  border-radius: 999px;
+  background: transparent;
+  color: var(--muted, #9296a2);
+  font-size: 12px;
+  white-space: nowrap;
+}
+.emoji-category-chip:hover { color: var(--text, #f1f1f4); border-color: var(--accent, #b9a0ff); }
+.emoji-category-chip.active {
+  color: var(--text, #f1f1f4);
+  border-color: var(--accent, #b9a0ff);
+  background: color-mix(in srgb, var(--accent, #b9a0ff) 15%, transparent);
+}
+
+.emoji-picker-status {
+  min-height: 32px;
+  padding: 8px 24px;
+  color: var(--muted, #9296a2);
+  font-size: 12px;
+}
+.emoji-picker-results {
+  flex: 1 1 auto;
+  min-height: 0;
+  overflow: auto;
+  padding: 4px 24px 12px;
+  overscroll-behavior: contain;
+}
+.emoji-results-group + .emoji-results-group { margin-top: 18px; }
+.emoji-results-group h3 {
+  margin: 0 0 9px;
+  color: var(--muted, #9296a2);
+  font-size: 12px;
+  font-weight: 700;
+  text-transform: uppercase;
+  letter-spacing: .08em;
+}
+.emoji-results-grid {
+  display: grid;
+  grid-template-columns: repeat(8, minmax(0, 1fr));
+  gap: 7px;
+}
+.emoji-choice {
+  display: flex;
+  min-width: 0;
+  min-height: 83px;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 7px;
+  padding: 9px 5px 7px;
+  overflow: hidden;
+  border: 1px solid var(--border, #2b2e35);
+  border-radius: 11px;
+  background: rgba(255,255,255,.018);
+  color: var(--text, #f1f1f4);
+  transition: background .12s ease, border-color .12s ease, transform .12s ease;
+}
+.emoji-choice:hover, .emoji-choice:focus-visible {
+  transform: translateY(-1px);
+  border-color: var(--accent, #b9a0ff);
+  background: color-mix(in srgb, var(--accent, #b9a0ff) 12%, transparent);
+  outline: none;
+}
+.emoji-choice-glyph {
+  display: block;
+  font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
+  font-size: 27px;
+  line-height: 1.2;
+}
+.emoji-choice-name {
+  display: -webkit-box;
+  width: 100%;
+  overflow: hidden;
+  color: var(--muted, #9296a2);
+  font-size: 10px;
+  line-height: 1.25;
+  text-align: center;
+  text-overflow: ellipsis;
+  -webkit-box-orient: vertical;
+  -webkit-line-clamp: 2;
+  overflow-wrap: anywhere;
+}
+.emoji-choice:hover .emoji-choice-name { color: var(--text, #f1f1f4); }
+.emoji-picker-empty {
+  padding: 48px 12px;
+  color: var(--muted, #9296a2);
+  text-align: center;
+}
+.emoji-picker-load-row {
+  display: flex;
+  justify-content: center;
+  padding: 10px 24px 14px;
+}
+.emoji-picker-load-row button { max-width: 100%; }
+.emoji-picker-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 13px 24px;
+  border-top: 1px solid var(--border, #2b2e35);
+  color: var(--muted, #9296a2);
+  font-size: 12px;
+}
+
+/* The enhanced Lucide selector uses progressive batches rather than a fixed cap. */
+.enhancement-icon-load-more {
+  display: block;
+  max-width: 100%;
+  margin: 14px auto;
+}
+
+@media (max-width: 760px) {
+  .emoji-picker-layer { padding: 0; place-items: stretch; }
+  .emoji-picker-dialog {
+    width: 100%;
+    max-height: 100dvh;
+    min-height: 100dvh;
+    border-radius: 0;
+    border-left: 0;
+    border-right: 0;
+  }
+  .emoji-picker-header { padding: 18px 16px 13px; gap: 12px; }
+  .emoji-picker-header h2 { font-size: 20px; }
+  .emoji-picker-header p { font-size: 12px; }
+  .emoji-picker-toolbar { padding: 12px 16px 8px; }
+  .emoji-picker-categories { padding: 5px 16px 12px; }
+  .emoji-picker-status { padding: 7px 16px; }
+  .emoji-picker-results { padding: 4px 16px 12px; }
+  .emoji-results-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
+  .emoji-choice { min-height: 77px; }
+  .emoji-choice-glyph { font-size: 25px; }
+  .emoji-picker-load-row { padding: 8px 16px 12px; }
+  .emoji-picker-footer { padding: 11px 16px; }
+}
+
+@media (max-width: 380px) {
+  .emoji-picker-clear { padding-inline: 9px; }
+  .emoji-picker-search-wrap { gap: 7px; padding-inline: 9px; }
+  .emoji-results-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+  .emoji-picker-footer { align-items: flex-start; }
+}
